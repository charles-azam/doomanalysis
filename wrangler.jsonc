{
  // Doom Analysis at doomanalysis.com: a Worker that serves the static Astro build and redirects
  // www.doomanalysis.com and the original doom.charlesazam.com to doomanalysis.com (see worker/index.ts).
  // Cloudflare Workers Builds deploys main from this repository. Never deploy by hand.
  // account_id pins every deploy to the account that owns both zones.
  "name": "doom",
  "account_id": "625c069e0532163edcb6ca8f144c6d42",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "doomanalysis.com", "custom_domain": true },
    { "pattern": "www.doomanalysis.com", "custom_domain": true },
    { "pattern": "doom.charlesazam.com", "custom_domain": true }
  ]
}
