---
import '../styles/pdoom.css'

type Props = {
  title: string
  description: string
  active?: 'home' | 'risks' | 'countries' | 'factors' | 'si' | 'methodology'
}

const { title, description, active } = Astro.props
const nav = [
  { href: '/risks/', label: 'Risks', key: 'risks' },
  { href: '/countries/', label: 'Countries', key: 'countries' },
  { href: '/superintelligence/', label: 'Superintelligence', key: 'si' },
  { href: '/methodology/', label: 'Methodology', key: 'methodology' },
]
const fullTitle = title === 'P(doom)' ? 'Doom Analysis: P(doom), collapse and abundance by 2100' : `${title} · Doom Analysis`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-[1320px] items-center justify-between gap-4 px-5 py-3">
        <a href="/" class="inline-flex items-center gap-2 rounded-full bg-black px-3.5 py-1.5 text-white" aria-current={active === 'home' ? 'page' : undefined}>
          <img src="/favicon.svg" alt="" width="18" height="18" />
          <span class="serif whitespace-nowrap text-[1.05rem] leading-none">Doom Analysis</span>
        </a>
        <nav class="pill-group hidden md:inline-flex">
          {
            nav.map((item) => (
              <a href={item.href} class="pill" aria-current={item.key === active ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
      <nav class="flex gap-1 overflow-x-auto px-5 pb-2 md:hidden">
        {
          nav.map((item) => (
            <a href={item.href} class="pill pill-solo" aria-current={item.key === active ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class="mx-auto max-w-[1320px] px-5 pb-16 pt-6">
      <slot />
    </main>
    <footer class="border-t py-8 text-sm" style="border-color: var(--line)">
      <div class="mx-auto flex max-w-[1320px] flex-wrap justify-between gap-2 px-5 muted">
        <span><a class="underline" href="/methodology/">Methodology</a> · <a class="underline" href="/factors/">Data</a></span>
        <span>Doom Analysis, by <a class="underline" href="https://charlesazam.com">Charles Azam</a></span>
      </div>
    </footer>
  </body>
</html>
