---
import Base from '../layouts/Base.astro'
import CardGrid from '../components/CardGrid.astro'
import DangerScale from '../components/DangerScale.astro'
import ChannelTable from '../components/ChannelTable.astro'
import EffectChart from '../components/EffectChart.astro'
import ScatterChart from '../components/ScatterChart.astro'
import { VerticalBars } from '../components/VerticalBars.tsx'
import { CauseChart } from '../components/CauseChart.tsx'
import { ChartCard } from '../components/ChartCard.tsx'
import { Compare } from '../components/Compare.tsx'
import { SixOutcomeBar, SixOutcomeLegend } from '../components/SixOutcomeBar.tsx'
import { TimelineChart } from '../components/TimelineChart.tsx'
import { cards } from '../data/cards.ts'
import { causeDefinitions } from '../data/definitions.ts'
import { countries, entities, pathFor } from '../data/entities.ts'
import { regionShort } from '../data/labels.ts'
import { causeColors, placeColors } from '../data/palette.ts'
import { causeTable, measureFor, outlook, people2100, placeRows, readingFor, siEffectFor, sixOutcomesFor } from '../data/outlook.ts'
import { rootCauses } from '../model/forecast.ts'
import type { CardGroup } from '../model/types.ts'

const rows = placeRows.map((row) => ({
  id: row.id,
  name: row.name,
  short: row.kind === 'country' ? row.name : (regionShort[row.id] ?? row.name),
  mark: row.kind === 'country' ? row.mark : '',
  color: placeColors[row.kind === 'country' ? (row.region ?? 'WLD') : row.id] ?? '#0b0b0b',
  kind: row.kind,
  href: row.href,
  outcomes: row.outcomes,
}))
const defaults = placeRows.filter((row) => row.kind !== 'country').map((row) => row.id)
const humanity = sixOutcomesFor({ id: 'WLD' })
const timeline = outlook.timeline
const groups: { group: CardGroup; title: string; color: string; line: string }[] = [
  ...rootCauses.map((cause) => ({ group: cause, title: causeDefinitions[cause].name, color: causeColors[cause], line: causeDefinitions[cause].text })),
  { group: 'technology', title: 'Technologies', color: '#2a78d6', line: 'Chance of each potential level: the share of humanity each could move up one outcome' },
  { group: 'living', title: 'How people live', color: '#008300', line: 'Living standards today and in 2100' },
]
const riskGroups = groups.filter((g) => cards.some((card) => card.group === g.group))
// What superintelligence changes: the world and regions, then every country for the scatter.
const headPlaces = entities.filter((e) => e.kind !== 'country')
const colorOf = (id: string, region?: string) => placeColors[region ?? id] ?? '#0b0b0b'
const hrefOf = (id: string) => (id === 'WLD' ? '/countries/world/' : pathFor({ entity: entities.find((e) => e.id === id) as (typeof entities)[number] }))
const nameOf = (id: string) => (id === 'WLD' ? 'World' : (regionShort[id] ?? id))
const aiBars = headPlaces
  .flatMap((e) => {
    const value = measureFor({ factorId: 'ai_use', id: e.id })
    return value === undefined ? [] : [{ key: e.id, label: nameOf(e.id), title: e.name, color: colorOf(e.id), href: hrefOf(e.id), value: value / 100 }]
  })
  .sort((a, b) => b.value - a.value)
const effectRows = headPlaces
  .flatMap((e) => {
    const effect = siEffectFor({ id: e.id })
    return effect === undefined ? [] : [{ id: e.id, name: e.kind === 'world' ? 'World' : e.name, href: hrefOf(e.id), color: colorOf(e.id), abundance: effect.abundance, down: effect.down }]
  })
  .sort((a, b) => b.abundance - a.abundance)
const scatter = countries.flatMap((country) => {
  const use = measureFor({ factorId: 'ai_use', id: country.id })
  const effect = siEffectFor({ id: country.id })
  return use === undefined || effect === undefined ? [] : [{ id: country.id, name: country.name, href: pathFor({ entity: country }), color: colorOf(country.id, country.region), x: use / 100, y: effect.better }]
})
const channelRows = headPlaces.flatMap((e) => {
  const reading = readingFor({ id: e.id })
  return reading === undefined ? [] : [{ id: e.id, name: e.kind === 'world' ? 'World' : e.name, href: hrefOf(e.id), color: colorOf(e.id), reading: reading }]
})
const hasSi = aiBars.length > 0 || effectRows.length > 0 || channelRows.length > 0

const nav = [
  { id: 'how-bad', title: 'How bad, and why', color: '#eb6834' },
  { id: 'places', title: 'Where it lands', color: '#e34948' },
  ...(hasSi ? [{ id: 'si-effect', title: 'What superintelligence changes', color: '#6250d6' }] : []),
  { id: 'over-time', title: 'Over time', color: '#0b0b0b' },
  { id: 'humanity', title: 'Humanity in 2100', color: '#c9c8c2' },
  ...riskGroups.map((g) => ({ id: g.group, title: g.title, color: g.color })),
]
---

<Base title="P(doom)" description="Independent estimates of collapse, decline and abundance by 2100 for 199 countries, with and without superintelligence." active="home">
  <section class="pb-10 pt-4">
    <h1 class="serif text-5xl leading-[1.02] tracking-tight sm:text-7xl">Independent analysis <br class="hidden sm:block" />of where we are heading</h1>
    <p class="mt-5 text-lg">Collapse, decline and abundance by 2100 for {countries.length} countries, with and without superintelligence</p>
  </section>

  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[190px_minmax(0,1fr)]">
    <aside class="hidden lg:block">
      <ul class="sticky top-24 flex flex-col gap-2 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={`#${item.id}`} class="flex items-center gap-2 hover:underline">
                <span class="square" style={`background: ${item.color}`} />
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>

    <div class="flex min-w-0 flex-col gap-16">
      <section id="how-bad" class="scroll-mt-24">
        <h2 class="section-title">
          <span class="square" style="background: #eb6834"></span>
          How bad, and why
        </h2>
        <p class="mb-4 mt-1 text-sm muted">Each catastrophe counts once, under the cause that started it, so the causes add up to 100%</p>
        <div class="mb-4"><DangerScale /></div>
        <CauseChart client:load table={causeTable} />
      </section>

      <section id="places" class="scroll-mt-24">
        <h2 class="section-title mb-5">
          <span class="square" style="background: #e34948"></span>
          Where it lands
        </h2>
        <Compare client:load rows={rows} defaults={defaults} />
      </section>

      {
        hasSi && (
          <section id="si-effect" class="scroll-mt-24">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="section-title">
                <span class="square" style="background: #6250d6" />
                What superintelligence changes
              </h2>
              <a href="/superintelligence/" class="inline-flex items-center gap-2 text-sm">
                Superintelligence <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-black text-white">↗</span>
              </a>
            </div>
            <p class="mb-5 mt-1 text-sm muted">Who gains depends on who has the AI, what they sell, and who owns the machines</p>
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
              {aiBars.length > 0 && (
                <ChartCard title="AI use" subtitle="Share of people aged 15–64 using AI, 2026 · Our proxy for tokens per person" color="#6250d6">
                  <VerticalBars bars={aiBars} color="#6250d6" max={Math.max(...aiBars.map((b) => b.value)) * 1.1} />
                </ChartCard>
              )}
              {effectRows.length > 0 && (
                <ChartCard title="Effect by 2100" subtitle="With superintelligence minus without, in points" color="#1f5fb0">
                  <EffectChart rows={effectRows} />
                </ChartCard>
              )}
            </div>
            {scatter.length > 0 && (
              <div class="mt-4">
                <ChartCard title="More AI, more gain?" subtitle="Each dot a country · change in people better off with superintelligence, against AI use today" color="#0b0b0b">
                  <ScatterChart
                    points={scatter}
                    xLabel="Share of people aged 15–64 using AI"
                    yLabel="Better off with SI (points)"
                    xMax={Math.ceil(Math.max(...scatter.map((p) => p.x)) * 10) / 10}
                    legend={headPlaces.filter((e) => e.kind === 'region').map((e) => ({ label: nameOf(e.id), color: colorOf(e.id) }))}
                  />
                </ChartCard>
              </div>
            )}
            {channelRows.length > 0 && (
              <div class="mt-4">
                <ChartCard title="How it works" subtitle="Judged effect of each channel on living standards by 2100, if superintelligence arrives" color="#6250d6">
                  <ChannelTable rows={channelRows} />
                </ChartCard>
              </div>
            )}
          </section>
        )
      }

      {
        timeline && (
          <section id="over-time" class="scroll-mt-24">
            <h2 class="section-title mb-5">
              <span class="square" style="background: #0b0b0b" />
              Over time
            </h2>
            <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
              <ChartCard title="Catastrophe" subtitle="Chance it has happened, by year · Lower is better" color="#e34948">
                <TimelineChart
                  points={timeline}
                  max={0.5}
                  lines={[
                    { key: 'atLeast3', label: 'Level 3+ (over 10% of humanity)', color: '#f09595' },
                    { key: 'atLeast4', label: 'Level 4+ (over half)', color: '#e34948' },
                    { key: 'doom', label: 'Doom', color: '#0b0b0b' },
                  ]}
                />
              </ChartCard>
              <ChartCard title="Superintelligence" subtitle="Chance it has arrived, by year" color="#6250d6">
                <TimelineChart points={timeline} max={1} lines={[{ key: 'si', label: 'Superintelligence', color: '#6250d6' }]} />
              </ChartCard>
            </div>
          </section>
        )
      }

      {
        humanity && (
          <section id="humanity" class="scroll-mt-24">
            <ChartCard title="Humanity in 2100" subtitle={`${(people2100 / 1e9).toFixed(1)} billion people, by the outcome of their region`} color="#c9c8c2">
              <div class="flex flex-col gap-3">
                <SixOutcomeLegend />
                {([['weighted', 'Our forecast'], ['si', 'With superintelligence'], ['noSi', 'Without']] as const).map(([key, label]) => (
                  <div class="grid grid-cols-[8.5rem_minmax(0,1fr)] items-center gap-3">
                    <span class="text-sm ink-2">{label}</span>
                    <SixOutcomeBar outcomes={humanity[key]} name={`Humanity, ${label}`} />
                  </div>
                ))}
              </div>
            </ChartCard>
          </section>
        )
      }

      <div id="risks" class="-mb-8 scroll-mt-24 border-t pt-10" style="border-color: var(--line)">
        <div class="w-full"><DangerScale /></div>
      </div>

      {
        riskGroups.map((g) => (
          <section id={g.group} class="scroll-mt-24">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="section-title">
                <span class="square" style={`background: ${g.color}`} />
                {g.title}
              </h2>
              {g.group in causeDefinitions && (
                <a href={`/causes/${g.group}/`} class="inline-flex items-center gap-2 text-sm">
                  Cause <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-black text-white">↗</span>
                </a>
              )}
            </div>
            <p class="mb-5 mt-1 text-sm muted">{g.line}</p>
            <CardGrid cards={cards} group={g.group} curves={outlook.curves} summary={true} />
          </section>
        ))
      }
    </div>
  </div>
</Base>
