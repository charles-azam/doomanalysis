---
import Base from '../layouts/Base.astro'
import FactorCard from '../components/FactorCard.astro'
import { Highlights } from '../components/Highlights.tsx'
import { factors } from '../data/factors.ts'
import { pathwayLabelsShort } from '../data/labels.ts'
import { globalSections } from '../data/sections.ts'
import { entityRows, latestJudgeDate, observationCount, projectionFor, verdict } from '../data/site.ts'
import { countries, regions } from '../data/entities.ts'
import { regionShort } from '../data/labels.ts'
import { observations } from '../data/observations.ts'
import { formatPercent, pathways, weighted } from '../model/judgment.ts'
import { observationFor } from '../model/score.ts'
import type { ScenarioKey } from '../model/types.ts'

const world = verdict.world
const doom = weighted({ world: world, pick: (s) => s.doom })
const keys: ScenarioKey[] = ['weighted', 'si', 'noSi']
const by = (pick: (scenario: ScenarioKey) => number) => Object.fromEntries(keys.map((k) => [k, pick(k)])) as Record<ScenarioKey, number>
const rows = entityRows.map((row) => ({
  id: row.id,
  name: row.name,
  short: row.kind === 'country' ? row.id : (regionShort[row.id] ?? row.name),
  mark: row.mark,
  kind: row.kind,
  href: row.href,
  outcomes: row.outcomes,
}))
const defaults = entityRows.filter((row) => row.kind !== 'country').map((row) => row.id)
const pathwayRows = pathways.map((pathway) => ({
  key: pathway,
  label: pathwayLabelsShort[pathway],
  value: by((k) => (k === 'weighted' ? weighted({ world: world, pick: (s) => s.pathways[pathway] }) : world[k].pathways[pathway])),
}))
const sectionFactors = globalSections.map((section) => ({
  section: section,
  items: factors
    .filter((factor) => factor.scope === 'global' && section.themes.includes(factor.theme))
    .flatMap((factor) => {
      const observation = observationFor({ observations: observations, factorId: factor.id, entity: 'WLD' })
      return observation === undefined ? [] : [{ factor: factor, observation: observation, projection: projectionFor({ factorId: factor.id, entity: 'WLD' }) }]
    }),
}))
const latest = [
  { tag: 'Climate', title: 'Climate Action Tracker, November 2026', text: '2.7 °C by 2100 on current policies: 92% chance of passing 2 °C, 33% of passing 3 °C.', href: '/learn/warming/' },
  { tag: 'Earth', title: 'Planetary Health Check 2026', text: '7 of 9 boundaries crossed; the ocean just passed its acidification limit.', href: '/learn/ocean_acidification/' },
  { tag: 'War', title: 'SIPRI and UCDP, 2026', text: '12,187 nuclear warheads; 65 state conflicts in 2025, a record for the third year running.', href: '/learn/nuclear_warheads/' },
  { tag: 'AI', title: 'METR, November 2026', text: 'The best model completes tasks of about 40 hours of expert work, doubling every few months.', href: '/learn/ai_horizon/' },
]
---

<Base title="P(doom)" description="The probability of doom, collapse and abundance by 2100, for the world and by country, with and without superintelligence, built from sourced indicators." active="home">
  <section class="grid grid-cols-1 gap-8 pb-10 pt-4 lg:grid-cols-[1fr_340px]">
    <div>
      <h1 class="serif text-5xl leading-[1.02] tracking-tight sm:text-7xl">
        {formatPercent({ value: doom })} chance of doom<br />by 2100
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-snug">
        Independent estimates of collapse and abundance for the world, {regions.length} regions and {countries.length} countries,
        from {observationCount.toLocaleString('en-US')} sourced data points, with and without superintelligence.
      </p>
    </div>
    <ul class="flex flex-col divide-y" style="border-color: var(--line)">
      {
        latest.map((item) => (
          <li class="py-3 first:pt-0">
            <a href={item.href} class="block hover:opacity-80">
              <p class="text-[11px] font-medium uppercase tracking-wide" style="color: var(--with-si)">{item.tag}</p>
              <p class="text-[15px]">{item.title}</p>
              <p class="text-sm muted">{item.text}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Highlights client:load rows={rows} pathways={pathwayRows} defaults={defaults} />

  <div class="mt-16 grid grid-cols-1 gap-10 lg:grid-cols-[180px_1fr]">
    <aside class="hidden lg:block">
      <ul class="sticky top-24 flex flex-col gap-2 text-sm">
        {
          globalSections.map((section) => (
            <li>
              <a href={`#${section.id}`} class="flex items-center gap-2 hover:underline">
                <span class="square" style={`background: ${section.color}`} />
                {section.title}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
    <div class="flex flex-col gap-14">
      {
        sectionFactors.map(({ section, items }) => (
          <section id={section.id} class="scroll-mt-24">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
              <h2 class="section-title">
                <span class="square" style={`background: ${section.color}`} />
                {section.title}
              </h2>
              <a href={`/factors/#${items[0]?.factor.id ?? ''}`} class="inline-flex items-center gap-2 text-sm">
                Sources <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-black text-white">↗</span>
              </a>
            </div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
              {items.map((item) => (
                <FactorCard factor={item.factor} observation={item.observation} projection={item.projection} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>
