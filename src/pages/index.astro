---
import Base from '../layouts/Base.astro'
import { CauseChart } from '../components/CauseChart.tsx'
import { ChartCard } from '../components/ChartCard.tsx'
import { Compare } from '../components/Compare.tsx'
import { SixOutcomeBar, SixOutcomeLegend } from '../components/SixOutcomeBar.tsx'
import { TimelineChart } from '../components/TimelineChart.tsx'
import { countries } from '../data/entities.ts'
import { regionShort } from '../data/labels.ts'
import { placeColors } from '../data/palette.ts'
import { causeTable, outlook, people2100, placeRows, sixOutcomesFor } from '../data/outlook.ts'

const rows = placeRows.map((row) => ({
  id: row.id,
  name: row.name,
  short: row.kind === 'country' ? row.name : (regionShort[row.id] ?? row.name),
  mark: row.kind === 'country' ? row.mark : '',
  color: placeColors[row.kind === 'country' ? (row.region ?? 'WLD') : row.id] ?? '#0b0b0b',
  kind: row.kind,
  href: row.href,
  outcomes: row.outcomes,
}))
const defaults = placeRows.filter((row) => row.kind !== 'country').map((row) => row.id)
const humanity = sixOutcomesFor({ id: 'WLD' })
const timeline = outlook.timeline
const section = (title: string, color: string, href: string, link: string) => ({ title, color, href, link })
const risks = section('Risks', '#e34948', '/risks/', 'All risks')
const people = section('People in 2100', '#1f5fb0', '/countries/', 'All countries')
---

<Base title="P(doom)" description="Independent estimates of collapse, decline and abundance by 2100 for 199 countries, with and without superintelligence." active="home">
  <section class="pb-10 pt-4">
    <h1 class="serif text-5xl leading-[1.02] tracking-tight sm:text-7xl">Independent analysis <br class="hidden sm:block" />of where we are heading</h1>
    <p class="mt-5 text-lg">Collapse, decline and abundance by 2100 for {countries.length} countries, with and without superintelligence</p>
  </section>

  <Compare client:load rows={rows} defaults={defaults} />

  {
    [risks].map((s) => (
      <div class="mb-5 mt-16 flex flex-wrap items-center justify-between gap-3">
        <h2 class="section-title">
          <span class="square" style={`background: ${s.color}`} />
          {s.title}
        </h2>
        <a href={s.href} class="inline-flex items-center gap-2 text-sm">
          {s.link} <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-black text-white">↗</span>
        </a>
      </div>
    ))
  }
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
    {
      timeline && (
        <ChartCard title="Catastrophe" subtitle="Chance it has happened, by year · Lower is better" color="#e34948">
          <TimelineChart
            points={timeline}
            max={0.5}
            lines={[
              { key: 'atLeast3', label: 'Over 10% of humanity', color: '#f09595' },
              { key: 'atLeast4', label: 'Over half', color: '#e34948' },
              { key: 'doom', label: 'Doom', color: '#0b0b0b' },
            ]}
          />
        </ChartCard>
      )
    }
    <CauseChart client:visible table={causeTable} scenario="weighted" />
    {
      timeline && (
        <ChartCard title="Superintelligence" subtitle="Chance it has arrived, by year" color="#6250d6">
          <TimelineChart points={timeline} max={1} lines={[{ key: 'si', label: 'Superintelligence', color: '#6250d6' }]} />
        </ChartCard>
      )
    }
  </div>

  <div class="mb-5 mt-16 flex flex-wrap items-center justify-between gap-3">
    <h2 class="section-title">
      <span class="square" style={`background: ${people.color}`}></span>
      {people.title}
    </h2>
    <a href={people.href} class="inline-flex items-center gap-2 text-sm">
      {people.link} <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-black text-white">↗</span>
    </a>
  </div>
  {
    humanity && (
      <ChartCard title="Humanity" subtitle={`${(people2100 / 1e9).toFixed(1)} billion people, by the outcome of their region`} color="#c9c8c2">
        <div class="flex flex-col gap-3">
          <SixOutcomeLegend />
          {([['weighted', 'Our forecast'], ['si', 'With superintelligence'], ['noSi', 'Without']] as const).map(([key, label]) => (
            <div class="grid grid-cols-[8.5rem_minmax(0,1fr)] items-center gap-3">
              <span class="text-sm ink-2">{label}</span>
              <SixOutcomeBar outcomes={humanity[key]} name={`Humanity, ${label}`} />
            </div>
          ))}
        </div>
      </ChartCard>
    )
  }
</Base>
