---
import Base from '../../layouts/Base.astro'
import CardGrid from '../../components/CardGrid.astro'
import { cards } from '../../data/cards.ts'
import { causeDefinitions } from '../../data/definitions.ts'
import { outlook } from '../../data/outlook.ts'
import { causeColors, dangerColors, levelInk, siColors } from '../../data/palette.ts'
import { rootCauses } from '../../model/forecast.ts'
import type { CardGroup } from '../../model/types.ts'

const groups: { group: CardGroup; title: string; color: string }[] = [
  ...rootCauses.map((cause) => ({ group: cause, title: causeDefinitions[cause].name, color: causeColors[cause] })),
  { group: 'technology', title: 'Technologies', color: '#2a78d6' },
  { group: 'living', title: 'How people live', color: '#008300' },
]
const present = groups.filter((g) => cards.some((card) => card.group === g.group))
const levels = [
  { level: 1 as const, share: '<1%' },
  { level: 2 as const, share: '1–10%' },
  { level: 3 as const, share: '10–50%' },
  { level: 4 as const, share: '>50%' },
  { level: 5 as const, share: 'doom' },
]
---

<Base title="Risks" description="Every risk, resource and technology on one danger scale, with the chance of each level by 2100." active="risks">
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[190px_minmax(0,1fr)]">
    <aside class="hidden lg:block">
      <ul class="sticky top-24 flex flex-col gap-2 text-sm">
        {
          present.map((g) => (
            <li>
              <a href={`#${g.group}`} class="flex items-center gap-2 hover:underline">
                <span class="square" style={`background: ${g.color}`} />
                {g.title}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
    <div class="flex min-w-0 flex-col gap-14">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h1 class="serif text-5xl tracking-tight">Risks</h1>
        <div class="flex flex-col items-end gap-2 text-xs ink-2">
          <div class="flex gap-4">
            <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-[2px]" style={`background: ${siColors.noSi}`}></span>Without superintelligence</span>
            <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-[2px]" style={`background: ${siColors.si}`}></span>With</span>
          </div>
          <a href="/methodology/#scale" class="flex flex-wrap items-center justify-end gap-1.5 hover:underline">
            <span>Share of humanity harmed:</span>
            {levels.map((level) => (
              <span class="inline-flex items-center gap-1 rounded px-1.5 py-0.5" style={`background: ${dangerColors[level.level]}; color: ${levelInk[level.level]}`}>
                {level.level} · {level.share}
              </span>
            ))}
          </a>
        </div>
      </div>
      {
        present.map((g) => (
          <section id={g.group} class="scroll-mt-24">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
              <h2 class="section-title">
                <span class="square" style={`background: ${g.color}`} />
                {g.title}
              </h2>
              {g.group in causeDefinitions && (
                <a href={`/causes/${g.group}/`} class="inline-flex items-center gap-2 text-sm">
                  Cause <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-black text-white">↗</span>
                </a>
              )}
            </div>
            <CardGrid cards={cards} group={g.group} curves={outlook.curves} />
          </section>
        ))
      }
    </div>
  </div>
</Base>
