---
import Base from '../layouts/Base.astro'
import { Dumbbell, SiLegend } from '../components/Dumbbell.tsx'
import { regions } from '../data/entities.ts'
import { definitions } from '../data/definitions.ts'
import { clinicalEvidence, muskEvidence, riskEvidence, timelineEvidence, type Evidence } from '../data/evidence.ts'
import { siDomains } from '../data/si-domains.ts'
import { arrivalSeries } from '../data/si-arrival.ts'
import { ArrivalChart } from '../components/ArrivalChart.tsx'
import HazardCard from '../components/HazardCard.astro'
import { SiTrend } from '../components/SiTrend.tsx'
import { frontier, siThreshold } from '../data/si-progress.ts'
import { cards } from '../data/cards.ts'
import { outlook, sixOutcomesFor, top } from '../data/outlook.ts'
import { formatPercent, sumCauses } from '../model/forecast.ts'
import type { Elasticity } from '../model/types.ts'

const world = outlook.world
const aiCards = cards.filter((card) => card.group === 'ai')
const pct = (value: number) => formatPercent({ value: value })
const elasticity: Record<Elasticity, { label: string; dots: number }> = {
  low: { label: 'Low', dots: 1 },
  medium: { label: 'Medium', dots: 2 },
  high: { label: 'High', dots: 3 },
  'two-sided': { label: 'Both ways', dots: 0 },
}
const evidenceGroups: { title: string; items: Evidence[] }[] = [
  { title: 'When superintelligence might arrive', items: timelineEvidence },
  { title: 'How risky it is, according to others', items: riskEvidence },
  { title: 'The abundance claim', items: muskEvidence },
]
const judgedRegions = regions.flatMap((region) => {
  const six = sixOutcomesFor({ id: region.id })
  return six ? [{ region: region, six: six }] : []
})
const down = (o: { collapse: number; doom: number }) => o.collapse + o.doom
const widerEverywhere = judgedRegions.length > 0 && judgedRegions.every(({ six }) => six.si.abundance > six.noSi.abundance && down(six.si) > down(six.noSi))
const takeover = { si: world.si.causes.ai.doom, noSi: world.noSi.causes.ai.doom }
const others = { si: sumCauses({ worldCase: world.si, key: 'doom' }) - takeover.si, noSi: sumCauses({ worldCase: world.noSi, key: 'doom' }) - takeover.noSi }
const muskGood = 0.8
const muskBad = 0.2
---

<Base title="Superintelligence" description="What superintelligence would and would not change for doom and abundance, and how likely it is to arrive by 2100." active="si">
  <h1 class="serif text-5xl tracking-tight">Superintelligence</h1>
  <p class="mt-3 max-w-2xl text-lg leading-snug">{definitions.superintelligence}</p>

  <section class="mt-6 grid gap-4 sm:grid-cols-3">
    <div class="card p-5">
      <p class="text-sm muted">P(SI by 2050)</p>
      <p class="text-4xl font-semibold tracking-tight">{pct(world.siBy2050)}</p>
    </div>
    <div class="card p-5">
      <p class="text-sm muted">P(SI by 2100)</p>
      <p class="text-4xl font-semibold tracking-tight">{pct(world.siBy2100)}</p>
    </div>
    <div class="card p-5">
      <p class="text-sm muted">P(doom by 2100), with SI vs without</p>
      <p class="text-4xl font-semibold tracking-tight">{pct(top.doomGivenSi)} <span class="text-xl muted">vs {pct(top.doomGivenNoSi)}</span></p>
    </div>
  </section>
  <p class="mt-2 text-xs muted">Judged by {outlook.model}, {outlook.worldRuns} independent runs. <a class="underline" href="/learn/superintelligence/">What superintelligence means</a> · <a class="underline" href="/learn/ai_loss_of_control/">Loss of control</a> · <a class="underline" href="/learn/ai_horizon/">The AI task horizon</a></p>

  {
    aiCards.length > 0 && (
      <section class="mt-8">
        <h2 class="section-title mb-2">
          <span class="square" style="background: var(--theme-ai)" />
          Progress so far, and the line that matters
        </h2>
        <p class="mb-5 max-w-3xl ink-2">
          The Artificial Analysis Progress Index puts every model on one scale, consistent over time. The uncertain step is not the trend but where on that scale
          superintelligence begins: the card shows that line as a range.
        </p>
        <div class="card mb-4 p-5">
          <h3 class="card-title mb-3">
            <span class="square" style="background: var(--theme-ai)" />
            The best model's Progress Index, extended in a straight line
          </h3>
          <SiTrend points={frontier} threshold={siThreshold} until={2034} />
          <p class="mt-2 text-xs muted">
            Scores from <a class="underline" href="https://artificialanalysis.ai/trends">Artificial Analysis</a>. The range is our reading of where superintelligence begins on this scale;
            <a class="underline" href="/learn/ai_progress_index/">how it is worked out</a>.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
          {aiCards.map((card) => <HazardCard card={card} judged={outlook.curves[card.id]} />)}
        </div>
      </section>
    )
  }

  <section class="card mt-8 p-6">
    <h2 class="card-title mb-3"><span class="square" style="background: var(--theme-ai)"></span>When superintelligence might arrive</h2>
    <ArrivalChart series={arrivalSeries} judged={[{ year: 2050, probability: world.siBy2050 }, { year: 2100, probability: world.siBy2100 }]} />
  </section>

  <section class="mt-10 card p-6">
    <h2 class="card-title">The claim being tested</h2>
    <div class="prose-site max-w-3xl">
      <p>
        Elon Musk argues that AI and robots will bring abundance, with “universal high income” and work becoming optional.
        He puts the chance of a good outcome at about {pct(muskGood)} and of a terrible one at 10–20%. Read as a forecast,
        that is P(abundance | SI) of roughly {pct(muskGood)}.
      </p>
      <p>
        This site tests it with a strict bar: abundance means nine in ten people living at least five times better than the rich world's average today.
        Superintelligence will speed up whatever is limited by thinking: design, discovery, optimization. Much of what separates a country from abundance
        is limited by something else: construction rates, clinical trials, ocean chemistry, mines, politics, war. The judged P(global abundance | SI) is
        <strong>{pct(world.si.abundance)}</strong>, against {pct(world.noSi.abundance)} without it. P(doom | SI) is
        <strong>{pct(top.doomGivenSi)}</strong>, compared with Musk's {pct(muskBad * 0.5)}–{pct(muskBad)}.
      </p>
    </div>
  </section>

  <section class="mt-10 card overflow-x-auto p-6">
    <h2 class="card-title">Where intelligence is the bottleneck, and where it is not</h2>
    <p class="mt-1 max-w-3xl text-sm ink-2">
      The site's working hypothesis, open to challenge. It is not given to the judge, so the probabilities do not simply
      echo it.
    </p>
    <table class="data mt-4 min-w-[760px]">
      <thead>
        <tr>
          <th>Domain</th>
          <th>What SI speeds up</th>
          <th>What stays slow</th>
          <th>Effect by 2050</th>
          <th>Effect by 2100</th>
        </tr>
      </thead>
      <tbody>
        {
          siDomains.map((domain) => (
            <tr>
              <td class="font-medium">{domain.domain}</td>
              <td class="ink-2">{domain.accelerates}</td>
              <td class="ink-2">{domain.bottleneck}</td>
              {[domain.by2050, domain.by2100].map((value) => (
                <td class="whitespace-nowrap">
                  <span aria-hidden="true" class="mr-1.5 tracking-widest" style="color: var(--with-si)">
                    {value === 'two-sided' ? '±' : '●'.repeat(elasticity[value].dots) + '○'.repeat(3 - elasticity[value].dots)}
                  </span>
                  {elasticity[value].label}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
    <div class="prose-site mt-4 max-w-3xl">
      <h3>The clinical-trial example</h3>
      <p>
        A drug that enters Phase I trials takes about {clinicalEvidence.years} years to reach approval, and only{' '}
        {pct(clinicalEvidence.successFromPhase1)} make it (<a class="link" href={clinicalEvidence.yearsSource.url}>{clinicalEvidence.yearsSource.label}</a>).
        The median cost per approved drug, counting failures, is about ${(clinicalEvidence.medianCostUsd / 1e9).toFixed(2)} billion
        (<a class="link" href={clinicalEvidence.costSource.url}>{clinicalEvidence.costSource.label}</a>). Superintelligence can
        pick better candidates and design better trials. It cannot make a five-year survival study take less than five
        years.
      </p>
    </div>
  </section>

  <section class="mt-10 card flex flex-col gap-4 p-6">
    <h2 class="card-title">What SI changes, region by region</h2>
    <SiLegend />
    <div class="grid gap-6 lg:grid-cols-2">
      <Dumbbell
        title="P(abundance in 2100)"
        max={1}
        rows={judgedRegions.map(({ region, six }) => ({ name: region.name, flag: region.mark, withSi: six.si.abundance, withoutSi: six.noSi.abundance }))}
      />
      <Dumbbell
        title="P(collapse or doom by 2100)"
        max={1}
        rows={judgedRegions.map(({ region, six }) => ({ name: region.name, flag: region.mark, withSi: down(six.si), withoutSi: down(six.noSi) }))}
      />
    </div>
  </section>

  <section class="mt-10">
    <div class="card p-6">
      <h2 class="card-title">Both edges</h2>
      <div class="prose-site">
        <p>
          Superintelligence is the strongest counterforce on the site, and the main source of a new risk. With SI, the
          judges put {pct(takeover.si)} on doom started by AI systems acting on their own, against {pct(takeover.noSi)} without it.
          Every other cause together goes from {pct(others.noSi)} without SI to {pct(others.si)} with it
          {others.si < others.noSi ? ', so the judges expect SI to defend against the older risks on balance.' : ', so the judges do not expect SI to defend against the older risks on balance.'}
        </p>
        <p>
          {
            widerEverywhere
              ? 'The result is a wider spread of outcomes. In every region the judges see both abundance and collapse as more likely with SI than without it.'
              : 'In some regions SI makes both abundance and collapse more likely; in others it shifts the odds one way only.'
          }
        </p>
        <p>
          That is why the site never folds SI into a single “technology” score. Every probability is shown with and
          without it.
        </p>
      </div>
    </div>
  </section>

  {
    evidenceGroups.map((group) => (
      <section class="mt-10 card overflow-x-auto p-6">
        <h2 class="card-title">{group.title}</h2>
        <table class="data mt-3 min-w-[700px]">
          <thead>
            <tr>
              <th>Who</th>
              <th>What</th>
              <th class="num">Value</th>
              <th>Source</th>
            </tr>
          </thead>
          <tbody>
            {group.items.map((item) => (
              <tr>
                <td class="whitespace-nowrap font-medium">{item.who}</td>
                <td class="ink-2">
                  {item.claim}
                  {item.caveat && <div class="mt-1 text-xs muted">{item.caveat}</div>}
                </td>
                <td class="num whitespace-nowrap font-semibold">{item.value}</td>
                <td class="text-xs">
                  <a class="link" href={item.url} target="_blank" rel="noopener">{item.source}</a>
                  <div class="muted">{item.date}</div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))
  }
</Base>
