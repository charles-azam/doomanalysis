---
import Base from '../layouts/Base.astro'
import { countries, pathFor, regions } from '../data/entities.ts'
import { factors } from '../data/factors.ts'
import { observations } from '../data/observations.ts'
import { explainerIds } from '../data/explainers.ts'
import { displayScore, formatValue, observationFor } from '../model/score.ts'
import type { FactorDefinition, Family } from '../model/types.ts'

const familyLabel: Record<Family, string> = {
  pillar: 'Essential',
  driver: 'Toward collapse',
  counterforce: 'Pushing back',
  context: 'Context',
}
const elasticityLabel = { low: 'Low', medium: 'Medium', high: 'High', 'two-sided': 'Both ways' }
const order: Family[] = ['pillar', 'driver', 'counterforce', 'context']
const countryFactors = factors
  .filter((factor) => factor.scope === 'country')
  .sort((a, b) => order.indexOf(a.family) - order.indexOf(b.family))
const globalFactors = factors
  .filter((factor) => factor.scope === 'global')
  .sort((a, b) => order.indexOf(a.family) - order.indexOf(b.family))

/** One hue per meaning, light to dark: red for pressure, blue for strength, gray for context. */
function cellStyle({ factor, score }: { factor: FactorDefinition; score: number }): string {
  if (factor.family === 'context') return 'background: var(--surface-2)'
  const hue = factor.family === 'counterforce' ? 'var(--abundance)' : 'var(--collapse)'
  return `background: color-mix(in oklab, ${hue} ${Math.round(8 + score * 0.62)}%, var(--surface))`
}
const anchorText = (factor: FactorDefinition) => {
  const a = factor.anchors
  const range = a.scale === 'two-sided' ? `distance from ${a.good}, 100 at ±${Math.abs(a.bad - a.good)}` : `${a.good} → ${a.bad}${a.scale === 'log' ? ' (log)' : ''}`
  return a.limit !== undefined ? `${range}; limit ${a.limit}` : range
}
---

<Base title="Data" description="Every indicator behind Doom Analysis, with values, sources, thresholds and how much superintelligence could change it." active="factors">
  <h1 class="serif text-5xl tracking-tight">Data</h1>
  <p class="mt-3 text-lg">Every country indicator, its value and its source</p>

  <section class="mt-8 card overflow-x-auto p-4">
    <h2 class="card-title mb-3">Regions and spotlight countries × factors</h2>
    <table class="data min-w-[900px]">
      <thead>
        <tr>
          <th>Country</th>
          {
            countryFactors.map((factor) => (
              <th class="num" title={factor.name}>
                <a href={`#${factor.id}`} class="hover:underline">{factor.short}</a>
                <div class="text-[10px] font-normal muted">{familyLabel[factor.family]}</div>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          [...regions, ...countries.filter((c) => c.spotlight)].map((country) => (
            <tr>
              <td class="whitespace-nowrap">
                <a class="link" href={pathFor({ entity: country })} style={country.kind === 'region' ? 'font-weight: 600' : undefined}>{country.mark} {country.name}</a>
              </td>
              {countryFactors.map((factor) => {
                const observation = observationFor({ observations: observations, factorId: factor.id, entity: country.id })
                if (observation === undefined) return <td class="num muted">—</td>
                const score = displayScore({ factor: factor, value: observation.value })
                return (
                  <td class="num" style={cellStyle({ factor: factor, score: score })} data-tip={`${factor.name}\n${formatValue({ factor: factor, value: observation.value })} ${factor.unit}\n${observation.year}`}>
                    {formatValue({ factor: factor, value: observation.value })}
                  </td>
                )
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="mt-3 text-xs muted">Darker red pushes toward collapse, darker blue pushes back · — no data</p>
  </section>

  {
    [
      { title: 'Global factors', list: globalFactors },
      { title: 'Country factors', list: countryFactors },
    ].map((block) => (
      <section class="mt-8 card overflow-x-auto p-4">
        <h2 class="card-title mb-3">{block.title}</h2>
        <table class="data min-w-[900px]">
          <thead>
            <tr>
              <th>Factor</th>
              <th>Role</th>
              <th>Scoring anchors (0 → 100)</th>
              <th>Basis</th>
              <th>SI elasticity</th>
              <th>What it measures</th>
            </tr>
          </thead>
          <tbody>
            {block.list.map((factor) => {
              const world = factor.scope === 'global' ? observationFor({ observations: observations, factorId: factor.id, entity: 'WLD' }) : undefined
              return (
                <tr id={factor.id}>
                  <td class="min-w-[12rem]">
                    <div class="font-medium">{explainerIds.has(factor.id) ? <a class="link" href={`/learn/${factor.id}/`}>{factor.name}</a> : factor.name}</div>
                    <div class="text-xs muted">{factor.unit}</div>
                    {world && (
                      <div class="mt-1 text-xs">
                        <span class="font-semibold tabular">{formatValue({ factor: factor, value: world.value })}</span> ({world.year},{' '}
                        <a class="link" href={world.url} target="_blank" rel="noopener">{world.source}</a>)
                      </div>
                    )}
                  </td>
                  <td>{familyLabel[factor.family]}</td>
                  <td class="tabular text-xs">
                    {anchorText(factor)}
                    <div class="mt-1 max-w-xs muted">{factor.anchors.rationale}</div>
                  </td>
                  <td class="text-xs">{factor.anchors.basis === 'published' ? 'Published threshold' : 'Judgment'}</td>
                  <td class="text-xs">
                    <div class="font-medium">{elasticityLabel[factor.siElasticity]}</div>
                    <div class="max-w-xs muted">{factor.siNote}</div>
                  </td>
                  <td class="max-w-sm text-xs ink-2">{factor.description}</td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </section>
    ))
  }
</Base>
