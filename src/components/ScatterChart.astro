---
type Point = { id: string; name: string; href: string; color: string; x: number; y: number }
type Props = { points: Point[]; xLabel: string; yLabel: string; xMax: number; legend: { label: string; color: string }[] }

const { points, xLabel, yLabel, xMax, legend } = Astro.props
const width = 640
const height = 300
const left = 44
const right = width - 12
const top = 12
const bottom = height - 40
const yAbs = Math.max(0.05, ...points.map((p) => Math.abs(p.y)))
const yMax = Math.ceil(yAbs * 20) / 20
const yMin = Math.min(0, Math.floor(Math.min(...points.map((p) => p.y)) * 20) / 20)
const x = (v: number) => left + (v / xMax) * (right - left)
const y = (v: number) => bottom - ((v - yMin) / (yMax - yMin)) * (bottom - top)
const xTicks = Array.from({ length: 5 }, (_, i) => (xMax / 4) * i)
const yTicks = Array.from({ length: Math.round((yMax - yMin) / 0.05) + 1 }, (_, i) => Number((yMin + 0.05 * i).toFixed(2)))
const pct = (v: number) => `${Math.round(v * 100)}%`
const pts = (v: number) => `${v > 0.0005 ? '+' : v < -0.0005 ? '−' : ''}${Math.round(Math.abs(v) * 100)}`
---

<div class="mb-2 flex flex-wrap gap-x-3 gap-y-1 text-[11px] ink-2">
  {
    legend.map((item) => (
      <span class="inline-flex items-center gap-1">
        <span class="inline-block h-2.5 w-2.5 rounded-full" style={`background: ${item.color}`} />
        {item.label}
      </span>
    ))
  }
</div>
<svg viewBox={`0 0 ${width} ${height}`} width="100%" role="img" aria-label={`${yLabel} against ${xLabel}, one point per country`}>
  {
    yTicks.map((tick) => (
      <g>
        <line x1={left} y1={y(tick)} x2={right} y2={y(tick)} stroke={Math.abs(tick) < 1e-9 ? 'var(--line)' : 'var(--grid)'} stroke-dasharray={Math.abs(tick) < 1e-9 ? undefined : '1 4'} />
        <text x={left - 6} y={y(tick) + 4} text-anchor="end" font-size="11" fill="var(--ink-muted)">{pts(tick)}</text>
      </g>
    ))
  }
  {Math.abs(yMin) > 1e-9 && <line x1={left} y1={y(0)} x2={right} y2={y(0)} stroke="var(--ink-muted)" stroke-width="1" />}
  {
    xTicks.map((tick) => (
      <text x={x(tick)} y={bottom + 16} text-anchor="middle" font-size="11" fill="var(--ink-muted)">{pct(tick)}</text>
    ))
  }
  <text x={(left + right) / 2} y={height - 4} text-anchor="middle" font-size="12" fill="var(--ink-2)">{xLabel}</text>
  <text x={12} y={(top + bottom) / 2} text-anchor="middle" font-size="12" fill="var(--ink-2)" transform={`rotate(-90 12 ${(top + bottom) / 2})`}>{yLabel}</text>
  {
    points.map((p) => (
      <a href={p.href}>
        <circle cx={x(p.x)} cy={y(p.y)} r="4.5" fill={p.color} fill-opacity="0.85" stroke="#ffffff" stroke-width="1">
          <title>{`${p.name}: ${pct(p.x)} use AI; ${pts(p.y)} points with superintelligence`}</title>
        </circle>
      </a>
    ))
  }
</svg>
