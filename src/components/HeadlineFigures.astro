---
import { formatPercent } from '../model/forecast.ts'
import type { Headline } from '../model/forecast.ts'
import type { HeadlineRecord } from '../model/types.ts'

type Props = { top: Headline; previous: HeadlineRecord | undefined; sameDefinitions: boolean }

const { top, previous, sameDefinitions } = Astro.props
const figures = [
  { key: 'doom', label: 'P(doom)', note: 'by 2100, our forecast', value: top.doom, color: 'var(--ink)', href: '#causes' },
  { key: 'doomGivenSi', label: 'P(doom | SI)', note: 'if superintelligence arrives', value: top.doomGivenSi, color: '#6250d6', href: '#causes' },
  { key: 'abundance', label: 'P(abundance)', note: '9 in 10 people live 5× better', value: top.abundance, color: '#1f5fb0', href: '#places' },
  { key: 'si', label: 'P(SI)', note: 'superintelligence by 2100', value: top.si, color: '#8a8985', href: '/superintelligence/' },
] as const
const change = (key: (typeof figures)[number]['key'], value: number) => {
  if (previous === undefined) return undefined
  const delta = (value - previous[key]) * 100
  if (Math.abs(delta) < 0.05) return 'unchanged'
  return `${delta > 0 ? '▲' : '▼'} ${Math.abs(delta).toFixed(Math.abs(delta) < 10 ? 1 : 0)} pts`
}
---

<div class="grid grid-cols-2 gap-px overflow-hidden rounded-lg border lg:grid-cols-4" style="border-color: var(--line); background: var(--line)">
  {
    figures.map((figure) => (
      <a href={figure.href} class="flex flex-col gap-1 bg-white p-5 hover:bg-[#fafaf8]">
        <span class="text-sm font-medium" style={`color: ${figure.color}`}>
          {figure.label}
        </span>
        <span class="serif text-5xl leading-none tracking-tight tabular sm:text-6xl">{formatPercent({ value: figure.value })}</span>
        <span class="text-xs muted">{figure.note}</span>
        {previous && (
          <span class="text-xs muted tabular">
            {sameDefinitions ? `${change(figure.key, figure.value)} since ${previous.version}` : `${previous.version}: ${formatPercent({ value: previous[figure.key] })}, earlier definitions`}
          </span>
        )}
      </a>
    ))
  }
</div>
