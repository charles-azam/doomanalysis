---
import type { FactorDefinition, Observation } from '../model/types.ts'
import { beyondLimit, displayScore, formatValue, limitPosition } from '../model/score.ts'
import { Meter } from './Meter.tsx'

type Props = {
  factor: FactorDefinition
  observation: Observation
}

const { factor, observation } = Astro.props
const score = displayScore({ factor: factor, value: observation.value })
const limit = limitPosition({ factor: factor })
const beyond = beyondLimit({ factor: factor, value: observation.value })
const kind = factor.family === 'counterforce' ? 'strength' : 'pressure'
const elasticity = {
  low: 'SI helps little',
  medium: 'SI helps somewhat',
  high: 'SI helps a lot',
  'two-sided': 'SI cuts both ways',
}[factor.siElasticity]
---

<article class="card flex flex-col gap-3 p-4" id={factor.id}>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-sm font-semibold leading-snug">{factor.name}</h3>
    <span class="tabular text-sm font-semibold" title={kind === 'pressure' ? 'Pressure score, 100 = worst' : 'Strength score, 100 = strongest'}>
      {Math.round(score)}
    </span>
  </div>
  <div class="flex items-baseline gap-1.5">
    <span class="text-2xl font-semibold tracking-tight">{formatValue({ factor: factor, value: observation.value })}</span>
    <span class="muted text-xs">{factor.unit}</span>
  </div>
  <Meter score={score} kind={kind} limit={limit} limitLabel={factor.anchors.limitLabel} />
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs ink-2">
    {
      factor.anchors.limit !== undefined && (
        <span class="inline-flex items-center gap-1">
          <span aria-hidden="true">{beyond ? '▲' : '✓'}</span>
          {factor.family === 'pillar' ? `${beyond ? 'Short of the' : 'Meets the'} ${factor.anchors.limitLabel?.toLowerCase()}` : `${beyond ? 'Past the limit' : 'Not past the limit'}: ${factor.anchors.limitLabel}`}
        </span>
      )
    }
    <span class="rounded px-1.5 py-0.5" style="background: var(--surface-2)" title={factor.siNote}>{elasticity}</span>
  </div>
  <p class="muted text-xs leading-relaxed">
    {observation.year} · <a class="link" href={observation.url} target="_blank" rel="noopener">{observation.source}</a>
    {observation.note && <span> · {observation.note}</span>}
  </p>
</article>
