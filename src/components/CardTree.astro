---
import HazardCard from './HazardCard.astro'
import { cardTree, type CardNode } from '../model/cards.ts'
import type { Card, CardGroup, CurveForecast } from '../model/types.ts'

type Props = { cards: Card[]; group: CardGroup; curves: Record<string, CurveForecast> }

const { cards, group, curves } = Astro.props
const roots = cardTree({ cards: cards, group: group })
/** Every card under a root, with the card it hangs from, in reading order. */
const descendants = (node: CardNode): { card: Card; parent: Card }[] => node.children.flatMap((child) => [{ card: child.card, parent: node.card }, ...descendants(child)])
const families = roots.map((root) => ({ root: root.card, rest: descendants(root) }))
const loners = families.filter((family) => family.rest.length === 0).map((family) => family.root)
const trees = families.filter((family) => family.rest.length > 0)
---

<div class="flex flex-col gap-6">
  {
    trees.map((family) => (
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        <HazardCard card={family.root} judged={curves[family.root.id]} />
        {family.rest.map((item) => (
          <div class="flex flex-col">
            <p class="mb-1 pl-1 text-[11px] muted">
              ↳ part of <a class="underline" href={`#${item.parent.id}`}>{item.parent.name}</a>
            </p>
            <div class="flex flex-1 flex-col [&>article]:flex-1">
              <HazardCard card={item.card} judged={curves[item.card.id]} compact={true} />
            </div>
          </div>
        ))}
      </div>
    ))
  }
  {
    loners.length > 0 && (
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        {loners.map((card) => (
          <HazardCard card={card} judged={curves[card.id]} />
        ))}
      </div>
    )
  }
</div>
