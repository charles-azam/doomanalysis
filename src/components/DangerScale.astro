---
import { dangerScale, potentialScale } from '../data/definitions.ts'
import { causeTable } from '../data/outlook.ts'
import { dangerColors, levelInk, potentialColors, potentialInk } from '../data/palette.ts'
import { formatPercent } from '../model/forecast.ts'

type Props = { scale?: 'danger' | 'potential' }

const { scale = 'danger' } = Astro.props
const isDanger = scale === 'danger'
const colors = isDanger ? dangerColors : potentialColors
const inks = isDanger ? levelInk : potentialInk
const references: Record<number, string> = {
  1: 'COVID-19',
  2: 'World War II, about 3% of humanity, and the 1918 flu, about 2.7%',
  3: 'the Black Death in Europe',
  4: 'no precedent',
  5: 'no precedent',
}
const shorts: Record<number, string> = isDanger
  ? { 1: 'under 1%', 2: '1–10%', 3: '10–50%', 4: 'over 50%', 5: 'doom' }
  : { 1: 'under 1%', 2: '1–10%', 3: '10–50%', 4: 'over 50%', 5: 'essential nearly free' }
// What the percentages on the chips are a share of.
const meaning = isDanger ? 'Danger level: share of humanity killed or ruined' : 'Potential level: share of humanity lifted one outcome'
const chance: Record<number, number | undefined> = { 2: causeTable.weighted.atLeast2?.total, 3: causeTable.weighted.atLeast3.total, 4: causeTable.weighted.atLeast4.total, 5: causeTable.weighted.doom.total }
const harm: Record<number, string> = {
  1: 'under 1% of humanity dies or lastingly loses decent living conditions',
  2: '1 to 10% of humanity dies or lastingly loses decent living conditions',
  3: '10 to 50% of humanity dies or lastingly loses decent living conditions',
  4: 'over half of humanity dies or lastingly loses decent living conditions, but civilisation can recover',
  5: 'human extinction, or a collapse with no recovery within a century',
}
const levels = (isDanger ? dangerScale : potentialScale)
  .filter((level) => level.level > 0)
  .map((level) => ({
    level: level.level,
    name: level.name,
    short: shorts[level.level],
    detail: isDanger
      ? `Level ${level.level}, ${level.name}: ${harm[level.level]}. For scale: ${references[level.level]}.${chance[level.level] !== undefined ? ` Our forecast gives ${formatPercent({ value: chance[level.level] as number })} that the world reaches this level or worse by 2100.` : ''}`
      : level.level === 5
        ? `Potential 5, ${level.name}: the technology alone makes an essential (energy, water, food or health) nearly free for everyone. A level is the share of humanity a technology alone moves up at least one outcome.`
        : `Potential ${level.level}, ${level.name}: the technology alone lifts ${level.share.replace(' moves up one outcome', '')} up at least one outcome, for example from stagnation to better.`,
  }))
---

<div class="flex flex-col gap-1.5" data-scale={scale}>
  <div class="flex flex-wrap items-center gap-1.5 text-[11px]" role="group" aria-label={isDanger ? 'Danger levels' : 'Potential levels'}>
    <span class="muted">{meaning}</span>
    {
      levels.map((level) => (
        <button
          type="button"
          data-level={level.level}
          aria-expanded="false"
          title={`${level.name}: ${level.short}. Click for more.`}
          class="rounded px-1.5 py-0.5 tabular"
          style={`background: ${colors[level.level]}; color: ${inks[level.level]}`}
        >
          {level.level} · {level.short}
        </button>
      ))
    }
  </div>
  {
    levels.map((level) => (
      <p data-level-detail={level.level} hidden class="rounded-md px-3 py-2 text-sm ink-2" style="background: var(--surface-2)">
        {level.detail} <a class="link" href="/methodology/#scale">Methodology</a>
      </p>
    ))
  }
</div>
